#!/bin/bash
# OpenStick: keep usb0 (RNDIS) bridged into br0 with 192.168.100.1/24.
#
# Runs as a small daemon (Type=simple) and re-applies the setup every few
# seconds, so USB access survives NetworkManager restarts, MAC rotation,
# gadget re-enumeration and anything else that tears br0/usb0 down.
set -u

log() { echo "openstick-usbnet: $*"; }

apply() {
    local usb mac created p
    usb=""
    for p in usb0 usb1; do
        if ip link show "$p" >/dev/null 2>&1; then usb="$p"; break; fi
    done
    [ -z "$usb" ] && return 1

    created=0
    if ! ip link show br0 >/dev/null 2>&1; then
        ip link add name br0 type bridge || return 1
        created=1
    fi

    # keep br0 MAC (= IPv6 link-local) in sync with the gadget
    mac="$(cat /sys/class/net/$usb/address 2>/dev/null)"
    if [ -n "$mac" ] && [ "$(cat /sys/class/net/br0/address 2>/dev/null)" != "$mac" ]; then
        ip link set dev br0 address "$mac" 2>/dev/null || true
    fi
    ip link set dev br0 type bridge stp_state 0 2>/dev/null || true
    ip link set dev br0 up 2>/dev/null || true

    for p in usb0 usb1; do
        ip link show "$p" >/dev/null 2>&1 || continue
        if [ "$(readlink -f /sys/class/net/$p/master 2>/dev/null)" != \
             "$(readlink -f /sys/class/net/br0 2>/dev/null)" ]; then
            ip link set dev "$p" master br0 2>/dev/null || true
        fi
        ip link set dev "$p" up 2>/dev/null || true
    done

    ip addr replace 192.168.100.1/24 dev br0 2>/dev/null || true
    ip -6 addr replace dead:beef::1/64 dev br0 2>/dev/null || true

    sysctl -q -w net.ipv4.ip_forward=1 2>/dev/null || true
    sysctl -q -w net.ipv6.conf.all.forwarding=1 2>/dev/null || true

    iptables -t nat -C POSTROUTING -s 192.168.100.0/24 ! -d 192.168.100.0/24 \
        -j MASQUERADE 2>/dev/null \
        || iptables -t nat -A POSTROUTING -s 192.168.100.0/24 ! -d 192.168.100.0/24 \
        -j MASQUERADE 2>/dev/null || true

    # br0 was just recreated -> dnsmasq lost its socket, give it a fresh one
    if [ "$created" = 1 ]; then
        systemctl try-restart dnsmasq >/dev/null 2>&1 || true
    fi
    return 0
}

# first pass: give the gadget a chance to appear
for _ in $(seq 1 120); do
    apply && { log "br0 ready"; break; }
    sleep 0.5
done

while true; do
    sleep 10
    apply || true
done
