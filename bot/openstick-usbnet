#!/bin/bash
# OpenStick: put usb0 (RNDIS) into br0 with 192.168.100.1/24
# Fixes the race where usb0 only appears after networking.service already ran.
set -u

for _ in $(seq 1 60); do
    ip link show usb0 >/dev/null 2>&1 && break
    sleep 0.5
done
if ! ip link show usb0 >/dev/null 2>&1; then
    echo "usb0 not present, nothing to do"
    exit 0
fi

if ! ip link show br0 >/dev/null 2>&1; then
    ip link add name br0 type bridge || exit 1
fi

# Keep the device MAC (and therefore the IPv6 link-local address) stable
ip link set dev br0 address "$(cat /sys/class/net/usb0/address)" 2>/dev/null || true
ip link set dev br0 type bridge stp_state 0 2>/dev/null || true
ip link set dev br0 up

for p in usb0 usb1; do
    if ip link show "$p" >/dev/null 2>&1; then
        ip link set dev "$p" master br0 2>/dev/null || true
        ip link set dev "$p" up 2>/dev/null || true
    fi
done

ip addr replace 192.168.100.1/24 dev br0
ip -6 addr replace dead:beef::1/64 dev br0 2>/dev/null || true

sysctl -q -w net.ipv4.ip_forward=1 2>/dev/null || true
sysctl -q -w net.ipv6.conf.all.forwarding=1 2>/dev/null || true

iptables -t nat -C POSTROUTING -s 192.168.100.0/24 ! -d 192.168.100.0/24 -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s 192.168.100.0/24 ! -d 192.168.100.0/24 -j MASQUERADE 2>/dev/null || true

echo "openstick-usbnet: br0 ready"
ip -4 addr show br0 | tail -n +2
