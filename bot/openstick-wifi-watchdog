#!/bin/bash
# OpenStick Wi-Fi watchdog + failover.
# Utama  : RUMAHKERIPIK
# Cadangan: Tahu Gejrot 4G
# - Internet mati -> pindah ke cadangan.
# - Cadangan jalan -> coba kembali ke utama tiap ~10 menit.
# - Tidak pernah pilih jaringan lain secara acak.
IF=wlan0
PRIMARY="RUMAHKERIPIK"
BACKUP="Tahu Gejrot 4G"
LOG=/var/log/openstick-wifi-watchdog.log
FAILS=0
RETRY=0

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
[ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && : > "$LOG"

has_internet() {
    curl -s --max-time 8 -o /dev/null https://api.ipify.org
}

active_wifi() {
    nmcli -t -f NAME,TYPE con show --active 2>/dev/null |
        awk -F: '$2=="802-11-wireless"{print $1; exit}'
}

has_profile() {
    nmcli -t -f NAME con show 2>/dev/null | grep -Fxq "$1"
}

connect_profile() {
    [ -n "$1" ] || return 1
    log "bringing up '$1'"
    nmcli con up "$1" >/dev/null 2>&1
}

log "wifi watchdog started (primary=$PRIMARY backup=$BACKUP)"

while true; do
    sleep 30

    # MAC rotation intentionally drops the link for ~15-30 s; tolerate it.
    if has_internet; then
        FAILS=0
        ACTIVE=$(active_wifi)

        if [ "$ACTIVE" != "$PRIMARY" ] && has_profile "$PRIMARY"; then
            RETRY=$((RETRY + 1))
            if [ "$RETRY" -ge 20 ]; then
                connect_profile "$PRIMARY"
                sleep 12
                if has_internet; then
                    log "back to primary '$PRIMARY'"
                else
                    log "primary '$PRIMARY' no internet, back to backup"
                    connect_profile "$BACKUP"
                fi
                RETRY=0
            fi
        else
            RETRY=0
        fi
        continue
    fi

    FAILS=$((FAILS + 1))
    log "no connectivity (fails=$FAILS)"

    if [ "$FAILS" -eq 3 ]; then
        ACTIVE=$(active_wifi)
        if [ "$ACTIVE" = "$PRIMARY" ] && has_profile "$BACKUP"; then
            log "primary no internet -> switch to backup"
            connect_profile "$BACKUP"
        elif [ "$ACTIVE" = "$BACKUP" ]; then
            log "reconnect backup"
            connect_profile "$BACKUP"
        elif has_profile "$PRIMARY"; then
            connect_profile "$PRIMARY"
        elif has_profile "$BACKUP"; then
            connect_profile "$BACKUP"
        fi
    elif [ "$FAILS" -ge 6 ]; then
        log "restarting NetworkManager"
        systemctl restart NetworkManager
        FAILS=0
    fi
done
