#!/bin/bash
# OpenStick: rotate wlan0 MAC and reconnect until the new public IP is not
# in /etc/tg-bot/ip_blacklist AND (kalau cookie tersedia) tidak langsung
# dibanned oleh EarnApp.
#
# Pemakaian: openstick-ghost [attempts] [ban_wait] [max_total]
#   attempts  : jumlah percobaan MAC/IP (default 4)
#   ban_wait  : detik menunggu verifikasi EarnApp per IP (default 90)
#   max_total : batas total waktu detik (default 300)
#
# Safety: the MAC used before this run is restored if every attempt fails
# (atau kalau proses dihentikan), so the node is never left offline.
# The MAC/IP that worked is saved to /etc/tg-bot/good_mac + ip_good.
set -u
BL="/etc/tg-bot/ip_blacklist"
STATE="/etc/tg-bot"
IF=wlan0
ATTEMPTS="${1:-4}"
BAN_WAIT="${2:-90}"
MAX_TOTAL="${3:-300}"
START=$(date +%s)

prof() {
    local p
    p=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null | grep ':802-11-wireless$' | head -1 | cut -d: -f1)
    [ -z "$p" ] && p=$(nmcli -t -f NAME,TYPE con show 2>/dev/null | grep ':802-11-wireless$' | head -1 | cut -d: -f1)
    printf '%s' "$p"
}

pubip() { curl -s -m 10 https://api.ipify.org 2>/dev/null; }

# tunggu sampai ada internet, maksimal $1 detik; cetak IP publik
wait_net() {
    local left="$1" ip=""
    while [ "$left" -gt 0 ]; do
        ip=$(pubip)
        if [ -n "$ip" ]; then
            printf '%s' "$ip"
            return 0
        fi
        sleep 3
        left=$((left - 3))
    done
    return 1
}

# Cek status device ini di EarnApp untuk IP saat ini.
# 0 = hijau, 1 = banned di IP ini, 2 = belum pasti (API error / IP belum terlihat)
ban_check() {
    python3 - "$1" <<'PY'
import json
import sys
import urllib.request

ip = sys.argv[1]
try:
    cookie = open("/etc/tg-bot/cookie", encoding="utf-8").read().strip()
    uuid = open("/etc/earnapp/uuid", encoding="utf-8").read().strip()
except OSError:
    print("pending (cookie/uuid tidak ada)")
    sys.exit(2)
if not cookie or not uuid:
    print("pending (cookie/uuid kosong)")
    sys.exit(2)
try:
    req = urllib.request.Request(
        "https://earnapp.com/dashboard/api/devices",
        headers={"Cookie": cookie,
                 "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                               "AppleWebKit/537.36 (KHTML, like Gecko) "
                               "Chrome/126.0 Safari/537.36",
                 "Accept": "application/json",
                 "Referer": "https://earnapp.com/dashboard",
                 "X-Requested-With": "XMLHttpRequest"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        devices = json.loads(resp.read().decode("utf-8", "replace"))
except Exception as exc:  # noqa: BLE001
    print("pending (api error: %s)" % exc)
    sys.exit(2)

me = next((d for d in devices
           if isinstance(d, dict) and d.get("uuid") == uuid), None)
if me is None:
    print("pending (device tidak ada di akun)")
    sys.exit(2)
ban = me.get("banned")
if isinstance(ban, dict):
    if str(ban.get("ip") or "") == ip:
        print("banned %s" % ip)
        sys.exit(1)
    # Ban lama masih tercatat; tunggu device check-in dengan IP baru.
    print("pending (ban lama %s)" % ban.get("ip"))
    sys.exit(2)
# banned == null berarti device hijau. Daftar "ips" di dashboard sering
# terlambat update, jadi jangan dijadikan syarat.
print("green %s" % ip)
sys.exit(0)
PY
}

add_bl() {
    local ip="$1"
    [ -z "$ip" ] && return
    touch "$BL" 2>/dev/null
    grep -qxF "$ip" "$BL" 2>/dev/null || echo "$ip" >> "$BL" 2>/dev/null
}

time_left() {
    echo $((MAX_TOTAL - ($(date +%s) - START)))
}

P=$(prof)
[ -z "$P" ] && { echo "ERROR: no wifi profile"; exit 1; }

# MAC sebelum ghost (biar bisa dibalikin kalau gagal)
OLD_CLONE=$(nmcli -g wifi.cloned-mac-address con show "$P" 2>/dev/null)
OLD_MAC=$(cat "/sys/class/net/$IF/address" 2>/dev/null)

restore_mac() {
    if [ -n "$OLD_CLONE" ]; then
        nmcli con modify "$P" wifi.cloned-mac-address "$OLD_CLONE" >/dev/null 2>&1
    else
        nmcli con modify "$P" wifi.cloned-mac-address "" >/dev/null 2>&1
    fi
    nmcli con down "$P" >/dev/null 2>&1
    sleep 2
    nmcli con up "$P" >/dev/null 2>&1
}

accept() {
    local mac="$1" ip="$2" note="$3"
    mkdir -p "$STATE" 2>/dev/null
    echo "$mac" > "$STATE/good_mac" 2>/dev/null
    echo "$ip" > "$STATE/ip_good" 2>/dev/null
    [ -n "$note" ] && echo "$note"
    echo "profile: $P"
    echo "mac: $(cat /sys/class/net/$IF/address 2>/dev/null)"
    echo "ip: $ip"
    exit 0
}

# Kalau proses dihentikan di tengah jalan, balikkan MAC lama.
trap 'echo "TERM: restoring previous MAC"; restore_mac; exit 143' TERM INT HUP

i=1
while [ "$i" -le "$ATTEMPTS" ]; do
    if [ "$(time_left)" -lt 45 ]; then
        echo "waktu habis sebelum attempt $i"
        break
    fi

    MAC=$(python3 -c "import random;print('02:%02x:%02x:%02x:%02x:%02x'%tuple(random.randrange(256) for _ in range(5)))")
    nmcli con modify "$P" wifi.cloned-mac-address "$MAC" >/dev/null 2>&1
    nmcli con down "$P" >/dev/null 2>&1
    sleep 3
    nmcli con up "$P" >/dev/null 2>&1

    IP=$(wait_net 25) || IP=""
    if [ -z "$IP" ]; then
        echo "attempt $i: no internet after 25s, retry"
    elif [ -f "$BL" ] && grep -qxF "$IP" "$BL"; then
        echo "attempt $i: $IP blacklisted (lokal), retry"
    else
        # Verifikasi ke EarnApp sebelum menerima IP ini, supaya satu kali
        # ghost bisa melewati beberapa IP yang sudah dibanned.
        verdict=2
        waited=0
        limit="$BAN_WAIT"
        left=$(time_left)
        if [ "$left" -lt "$limit" ]; then
            limit=$((left - 10))
            [ "$limit" -lt 15 ] && limit=15
        fi
        while [ "$waited" -lt "$limit" ]; do
            OUT=$(ban_check "$IP")
            verdict=$?
            [ "$verdict" -ne 2 ] && break
            sleep 10
            waited=$((waited + 10))
        done
        if [ "$verdict" -eq 1 ]; then
            echo "attempt $i: $IP banned by earnapp ($OUT), blacklist + retry"
            add_bl "$IP"
        else
            if [ "$verdict" -eq 0 ]; then
                accept "$MAC" "$IP" "verified green on earnapp ($OUT)"
            else
                accept "$MAC" "$IP" "WARN: belum terverifikasi ($OUT), terima $IP"
            fi
        fi
    fi
    i=$((i + 1))
done

# Semua percobaan gagal: balikkan MAC lama supaya node tetap online.
echo "WARN: all attempts failed, restoring previous MAC"
restore_mac
IP=$(wait_net 25) || IP=""
echo "profile: $P"
echo "mac: $(cat /sys/class/net/$IF/address 2>/dev/null)"
echo "ip: ${IP:-none}"
[ -n "$IP" ] && echo "restored previous MAC, online again" || echo "ERROR: still offline"
exit 2
